{
  "name": "takeoff-demo",
  "version": "1.0.0",
  "description": "Takeoff: frame-exact silent purchase-card prototype film",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.524",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render src/index.ts Takeoff out/takeoff-75s.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --muted",
    "render:social": "remotion render src/index.ts Substitution out/takeoff-substitution-12s.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --muted",
    "finalize": "node finalize.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
